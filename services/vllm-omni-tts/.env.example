# vLLM-Omni Qwen3-TTS sidecar configuration

# HTTP port (webapp connects to http://<host>:${VLLM_PORT})
VLLM_PORT=8091

# Hugging Face model served by this instance (must be Base for NPC clone workflow)
VLLM_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base

# Pin GPU when multiple cards present (empty = default CUDA device)
CUDA_VISIBLE_DEVICES=0

# Passed to vllm serve
VLLM_GPU_MEMORY_UTILIZATION=0.35
VLLM_ENFORCE_EAGER=1

# Prefix for NPC voices registered from natural_20 campaigns (must match webapp)
VLLM_VOICE_PREFIX=n20_

# Consent string required by POST /v1/audio/voices
VLLM_VOICE_CONSENT=campaign_baked
